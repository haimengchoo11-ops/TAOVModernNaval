plugins {
    id 'eclipse'
    id 'idea'
    id 'net.minecraftforge.gradle' version '5.1.+'
    id 'org.spongepowered.mixin' version '0.7.+'
}

apply plugin: 'net.minecraftforge.gradle'
apply plugin: 'org.spongepowered.mixin'

version = '1.0.0'
group = 'com.taovmn'
archivesBaseName = 'taovmodernnaval'

java.toolchain.languageVersion = JavaLanguageVersion.of(17)

minecraft {
    mappings channel: 'official', version: '1.20.1'

    runs {
        client {
            workingDirectory project.file('run')
            ideaModule "${project.name}.main"
            taskName 'Client'
            
            property 'forge.logging.console.level', 'debug'

            mods {
                taovmodernnaval {
                    source sourceSets.main
                }
            }
        }

        server {
            workingDirectory project.file('run')
            ideaModule "${project.name}.main"
            taskName 'Server'
            
            property 'forge.logging.console.level', 'debug'

            mods {
                taovmodernnaval {
                    source sourceSets.main
                }
            }
        }
    }
}

sourceSets.main.resources { srcDir 'src/main/resources' }

repositories {
    mavenCentral()
    maven { url = 'https://maven.minecraftforge.net' }
}

dependencies {
    minecraft 'net.minecraftforge:forge:1.20.1-47.3.0'
}

jar {
    manifest {
        attributes([
            'Specification-Title': 'taovmodernnaval',
            'Specification-Version': '1',
            'Specification-Vendor': 'taovmn',
            'Implementation-Title': project.name,
            'Implementation-Version': project.version,
            'Implementation-Vendor': 'taovmn',
            'Implementation-Timestamp': new Date().format("yyyy-MM-dd'T'HH:mm:ssZ"),
            'Created-By': 'Gradle'
        ])
    }
}

processResources {
    var replaceProperties = [
        minecraft_version: '1.20.1',
        minecraft_version_range: '[1.20.1,1.21)',
        forge_version: '47.3.0',
        forge_version_range: '[47,)',
        loader_version_range: '[47,)',
        mod_id: 'taovmodernnaval',
        mod_name: 'TAOVModernNaval',
        mod_license: 'MIT',
        mod_version: project.version,
        mod_authors: 'choohaimeng',
        mod_description: 'A modern naval warfare mod for Minecraft'
    ]
    inputs.properties replaceProperties

    filesMatching(['META-INF/mods.toml', 'pack.mcmeta']) {
        expand replaceProperties
    }
}
